# A chave e o modelo de IA são configurados na aplicação (OpenRouter).
# Eles ficam criptografados no SQLite local e não devem ser colocados aqui.
BACKEND_PORT=3001
FRONTEND_PORT=5173
DATABASE_PATH=./data/vagas.db
RESUME_PATH=./resume.md
SEARCH_QUERY_PATH=./search-query.txt
CLIENT_ORIGIN=http://localhost:5173

# Job search providers (optional — providers without keys work without configuration)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# LinkedIn Jobs (optional — requires LinkedIn Developer app credentials)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
# LINKEDIN_API_VERSION=202603
# LINKEDIN_MAX_RESULTS=50
